# ============================================================
# Hugo — сгенерированные файлы
# ============================================================

# Итоговая сборка сайта.
# Пересоздаётся при каждом запуске hugo.
# Не хранится в Git.
public/

# Кэш Hugo Pipes (сгенерированные CSS/JS и другие ресурсы).
# Создаётся автоматически во время сборки.
# Не хранится в Git.
resources/_gen/

# Конфигурация JavaScript для редакторов.
# Создаётся Hugo автоматически.
assets/jsconfig.json

# Статистика использования HTML-элементов.
# Генерируется Hugo и может использоваться PurgeCSS
# для удаления неиспользуемых CSS-стилей.
hugo_stats.json

# Файл блокировки Hugo.
# Создаётся во время сборки и предотвращает
# параллельный запуск нескольких процессов Hugo.
.hugo_build.lock


# ============================================================
# Архив проекта
# ============================================================

# ВАЖНО:
# _archive/ НЕ добавляем в .gitignore.
#
# Здесь хранятся старые и неиспользуемые исходники,
# которые больше не являются частью текущего сайта,
# но могут понадобиться в будущем.
#
# Например:
# _archive/
# ├── old-layout/
# ├── old-icons/
# └── old-images/
#
# Архив хранится в Git, чтобы другие участники команды
# могли видеть историю и при необходимости восстановить файлы.


# ============================================================
# Node.js
# ============================================================

# Зависимости Node.js.
# Устанавливаются через npm install / npm ci.
# Не хранятся в Git.
node_modules/


# ============================================================
# Операционная система
# ============================================================

# macOS — служебный файл Finder.
.DS_Store

# Windows — кэш миниатюр Проводника.
Thumbs.db


# ============================================================
# Редакторы и IDE
# ============================================================

# Visual Studio Code.
.vscode/

# JetBrains IDE — WebStorm, PhpStorm и др.
.idea/

# Временные файлы редактора Vim.
*.swp
*.swo

# Локальные настройки Prettier.
# Обычно конфигурацию проекта лучше хранить в Git,
# поэтому эта строка нужна только если .prettierrc
# является персональной конфигурацией разработчика.
.prettierrc
