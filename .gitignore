# Сгенерированные файлы Hugo
# Итоговая сборка сайта — пересоздаётся при каждом запуске hugo
/public/
# Кэш пайплайнов Hugo (CSS/JS) — генерируется автоматически
/resources/_gen/
# Конфиг для редакторов, создаётся Hugo
/assets/jsconfig.json
# Статистика использования классов — нужна только для Tailwind/PostCSS
hugo_stats.json

# Файлы блокировки Hugo
# Создаётся на время сборки, предотвращает параллельный запуск
.hugo_build.lock

# Зависимости Node.js
# Устанавливаются через npm install, восстанавливаются одной командой
/node_modules/

# Системные файлы ОС
# macOS — служебный файл Finder
.DS_Store
# Windows — кэш миниатюр проводника
Thumbs.db

# Редакторы и IDE
# Настройки Visual Studio Code
.vscode/
# Настройки JetBrains (WebStorm, PhpStorm и др.)
.idea/
# Временные файлы редактора Vim
*.swp
# Временные файлы редактора Vim (альтернативный суффикс)
*.swo
# Настройки форматтера Prettier
.prettierrc
